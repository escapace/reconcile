{
  "name": "@escapace/reconcile",
  "description": "Detached snapshots, in-place reconciliation, draft-based next-value construction, and graph-preserving JSON serialization for JavaScript objects, arrays, maps, and sets.",
  "version": "0.0.0",
  "author": {
    "name": "escapace",
    "email": "opensource@escapace.com"
  },
  "bugs": "https://github.com/escapace/reconcile/issues",
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@escapace/pnpm-pack": "0.9.2",
    "@escapace/syncpack-configuration": "0.3.0",
    "@ls-lint/ls-lint": "2.3.1",
    "@vitest/coverage-v8": "5.0.3",
    "alien-deepsignals": "0.4.3",
    "arktype": "2.2.8",
    "es-toolkit": "1.51.0",
    "eslint": "10.12.0",
    "eslint-config-escapace": "5.20.4",
    "esroll": "1.3.1",
    "fallow": "3.34.0",
    "fast-check": "4.10.2",
    "immer": "11.1.21",
    "lefthook": "2.2.0",
    "prettier": "3.9.9",
    "prettier-config-escapace": "1.2.2",
    "syncpack": "15.3.3",
    "tinybench": "6.2.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "vue": "3.5.43"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "warn",
      "version": "^12.0.0"
    }
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/neutral/index.js"
    }
  },
  "files": [
    "lib/neutral",
    "lib/types"
  ],
  "homepage": "https://github.com/escapace/reconcile#readme",
  "license": "MPL-2.0",
  "module": "lib/neutral/index.js",
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": "escapace/reconcile",
  "scripts": {
    "bench": "tsx scripts/bench.ts",
    "build": "tsx scripts/build.ts && prettier --log-level warn --write README.md",
    "check:lean": "python3 scripts/check-lean.py",
    "format": "syncpack format && eslint --no-warn-ignored --fix && prettier --log-level warn --no-error-on-unmatched-pattern -uw .",
    "lint": "ls-lint --config .ls-lint.yaml && fallow --fail-on-issues && eslint --concurrency auto",
    "ls-lint": "ls-lint --config .ls-lint.yaml",
    "pack": "pnpm-pack package --pack-destination lib",
    "prepare": "lefthook install",
    "syncpack": "syncpack fix && syncpack format",
    "test": "vitest --no-watch --coverage --coverage.reporter=json --coverage.reporter=text-summary",
    "test:lib": "vitest --no-watch --config vitest-library.config.ts",
    "typecheck": "tsc --noEmit",
    "update": "ncu --cooldown 7 -p pnpm -u --peer --dep dev,peer,prod,optional && pnpm run syncpack"
  },
  "sideEffects": false,
  "type": "module",
  "types": "lib/types/index.d.ts"
}
